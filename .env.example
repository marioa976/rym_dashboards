# ============================================================
#  Plantilla de variables de entorno (SÍ se sube a git).
#  Copia este archivo a ".env" y rellena los valores reales.
#  En Cloud Run, define estas mismas variables en el servicio.
# ============================================================
APP_ENV=local                 # local | production
APP_BASE_URL=/portal          # en Cloud Run normalmente "/"

# --- BD del portal (portal + DIF + Zendesk viven aquí) ---
DB_HOST=127.0.0.1
DB_PORT=8889                  # MAMP=8889; servidor MariaDB típico=3306
DB_NAME=portal_qro
DB_USER=
DB_PASS=

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=
MAP_ID=DEMO_MAP_ID            # crea uno propio en Google Cloud Console para producción

# --- API de Zendesk ---
ZENDESK_SUBDOMAIN=
ZENDESK_USER=                 # correo + "/token"
ZENDESK_TOKEN=
ZENDESK_TAG_DEFAULT=servicio_recoleccion_tiliches

# --- BD remota de Qrobici ---
QROBICI_DB_HOST=
QROBICI_DB_PORT=3306
QROBICI_DB_NAME=qrobici
QROBICI_DB_USER=
QROBICI_DB_PASS=

# --- Waze ---
WAZE_FEED_URL=
