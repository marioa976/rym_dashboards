# Raíz del portal — protección básica.

# No servir archivos ocultos por web (.env, .gitignore, .htaccess, etc.)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# No servir archivos sensibles o de despliegue
<FilesMatch "\.(env|sql|lock|md|yml|yaml)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(Dockerfile|composer\.(json|lock))$">
  Require all denied
</FilesMatch>

# Página de entrada
DirectoryIndex index.php

# =====================================================================
#  Cabeceras de seguridad (securityheaders.com: F -> A)
#  Requiere mod_headers (ya activo en el Dockerfile: a2enmod headers).
# =====================================================================
<IfModule mod_headers.c>
  # Fuerza HTTPS por 2 años, incluidos subdominios. (Solo se aplica sobre HTTPS.)
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

  # Evita que el sitio se cargue dentro de un iframe (clickjacking).
  Header always set X-Frame-Options "SAMEORIGIN"

  # El navegador no "adivina" tipos MIME (evita ejecutar como script un archivo mal servido).
  Header always set X-Content-Type-Options "nosniff"

  # No filtrar la URL completa como referer a otros sitios.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Desactiva APIs del navegador que el portal no usa.
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"

  # Aísla el contexto de navegación (protege de ataques cross-origin tipo Spectre).
  # 'allow-popups' para no estorbar ventanas emergentes legítimas (Google, etc.).
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

  # No exponer que corre PHP.
  Header always unset X-Powered-By
  Header unset X-Powered-By

  # Content-Security-Policy: permite lo que el portal realmente carga
  #   - Google Maps + Fonts, unpkg (Leaflet/deck.gl), cdnjs (Chart.js), jsDelivr
  #   - 'unsafe-inline'/'unsafe-eval' porque hay <script>/<style> en línea y libs de mapas los usan.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://maps.googleapis.com https://maps.gstatic.com https://unpkg.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://maps.googleapis.com https://a.nel.cloudflare.com https://*.basemaps.cartocdn.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>
